# Local runs with Azure Storage state (after bootstrap/). Not used when dev/remote_backend.tf
# uses the Terraform Cloud block for PlatformForge.

terraform {
  required_version = ">= 1.9.0, < 2.0.0"

  backend "azurerm" {
    key = "aks-clusters-weu/dev.tfstate"
  }

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.81"
    }
    time = {
      source  = "hashicorp/time"
      version = "~> 0.12"
    }
  }
}
