# Copy to remote_backend.tf when using Terraform Cloud for state (replaces backend "azurerm").
# Set organization and workspace name to match the workspace you created in Part C.

terraform {
  required_version = ">= 1.9.0, < 2.0.0"

  cloud {
    organization = "YOUR_TFC_ORG_NAME"

    workspaces {
      name = "aks-clusters-dev-weu"
    }
  }

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.81"
    }
    time = {
      source  = "hashicorp/time"
      version = "~> 0.12"
    }
  }
}
